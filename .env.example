# Configure no ambiente do backend. Este arquivo não é carregado automaticamente.
# Use a URL com pool de conexões fornecida pelo seu provedor PostgreSQL.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Apenas para desenvolvimento local sem DATABASE_URL:
# FINANCE_DB=data/finance.db

# Obrigatório para permitir acesso. Separe os dois e-mails por vírgula.
# Lista ausente, vazia ou inválida bloqueia cadastro, login e sessões.
ALLOWED_EMAILS=voce@example.com,outra-pessoa@example.com

# Gere com: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Cole o valor gerado abaixo no seu ambiente privado (32 a 256 caracteres).
# Vazio mantém novos cadastros fechados, mas permite login das contas autorizadas.
REGISTRATION_INVITE_CODE=
